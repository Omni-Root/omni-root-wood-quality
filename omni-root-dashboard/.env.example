# Copie para ".env" e preencha. O .env real nunca vai pro Git.
# Nomes idênticos aos usados pelo sync.go / .env.example do repo principal.

PG_HOST=192.168.1.100
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DBNAME=desafio_madeira

# "true" se o Postgres central exigir TLS (ex.: nuvem gerenciada)
PG_SSL=false

# Porta da API de leitura (o Vite dev server usa proxy para ela)
API_PORT=3001

# Este arquivo guarda só o que é da INSTALAÇÃO (endereço do banco, porta,
# segredos, túnel). Contas e regras da aplicação ficam no BANCO: tabelas
# usuarios e configuracoes, editadas nas telas "Usuários" e "Configurações"
# do painel (admin).

# --- Contas do dashboard (tabela usuarios) ---
# Primeiro admin (uma vez):
#   npm run usuario -- criar voce@empresa.com --papel admin
#
# PG_CONTAS_USER é um login DO POSTGRES (não uma conta do painel!) usado SÓ
# para as tabelas usuarios e configuracoes — os dados continuam numa conexão
# somente-leitura. Criar uma vez, como superusuário, depois de aplicar o
# setup_completo.sql:
#   CREATE ROLE omniroot_dashboard_contas LOGIN PASSWORD '...' IN ROLE omniroot_contas;
# Vazio = usa o PG_USER acima (prático em desenvolvimento; em produção, crie).
# Se estiver errado, o servidor diz o motivo no console ao subir.
PG_CONTAS_USER=
PG_CONTAS_PASSWORD=

# Segredo que assina o cookie de sessão. Opcional: sem ele, um segredo
# aleatório é gerado a cada boot (as sessões caem quando o servidor reinicia).
SESSION_SECRET=

# --- Login social (Google, Microsoft, GitHub) — opcional ---
# Entra quem tem CONTA ativa com o login igual ao e-mail verificado pelo
# provedor (cadastre o e-mail na tela "Usuários"; a conta pode nem ter senha).
# Se quem NÃO tem conta entra como visitante é uma configuração do banco
# (tela "Configurações": "Login social sem cadastro entra como visitante").
#
# Em cada provedor, crie um "app OAuth" e cadastre o endereço de retorno
# (troque a base se o painel não abrir em http://localhost:5173):
#   Google   -> console.cloud.google.com > APIs e serviços > Credenciais >
#               ID do cliente OAuth (Aplicativo da Web)
#               retorno: http://localhost:5173/api/auth/google/retorno
#   Microsoft-> portal.azure.com > Microsoft Entra ID > Registros de aplicativo >
#               Novo registro ("Contas em qualquer diretório organizacional e
#               contas pessoais"); plataforma Web; crie um segredo do cliente
#               retorno: http://localhost:5173/api/auth/microsoft/retorno
#   GitHub   -> github.com/settings/developers > OAuth Apps
#               retorno: http://localhost:5173/api/auth/github/retorno
# Botão sem as duas variáveis do provedor = desativado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Contas aceitas na Microsoft: as PESSOAIS (Outlook/Hotmail/Live) sempre; de
# organização, só a deste ID de locatário (GUID do Entra ID, ex.: o da
# faculdade). Vazio = só contas pessoais. Conta de outra organização é
# recusada: o e-mail dela é definido pelo admin de lá e não prova nada.
MICROSOFT_TENANT=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Opcional: base fixa do endereço de retorno (ex.: atrás de HTTPS/proxy).
# Vazio = a do próprio navegador (http://localhost:5173 em desenvolvimento).
OAUTH_URL_BASE=

# --- Câmera ao vivo e posição da frota (empurradas pelo main.py da máquina) ---
# Token que a máquina envia no header X-Stream-Token. Sem ele, as rotas
# /api/camera/frame (503) e /api/maquinas/posicao (401) ficam desligadas.
# Mesmo valor do STREAM_TOKEN no .env do repositório principal. Depois de
# quanto tempo sem quadro/posição o painel mostra "Sem sinal" é configuração
# do banco (tela "Configurações").
STREAM_TOKEN=

# --- Painel no celular da plateia (QR code no canto + tecla Q) ---
# Qual túnel o `npm run dev` abre (scripts/tunel.mjs). Vazio = sem túnel e
# sem QR.
#   zrok       zrok (grátis): https://<ZROK_NOME>.shares.zrok.io, nome
#              reservado uma vez com `zrok2 create name <nome>`. Precisa do
#              zrok2.exe e da conta ativada (`zrok2 enable <token da conta>`).
#   tailscale  Tailscale Funnel (grátis): endereço fixo do notebook,
#              https://<notebook>.<rede>.ts.net, lido do próprio Tailscale.
#              Precisa do Tailscale instalado e logado e do Funnel liberado.
#   ngrok      domínio FIXO da conta (painel do ngrok: Domains) em
#              NGROK_DOMAIN; precisa do ngrok instalado e do authtoken
#              (aqui ou em `ngrok config add-authtoken`).
TUNEL=
ZROK_NOME=
# Opcional: domínio do zrok, se o `zrok2 share` mostrar outro (padrão shares.zrok.io)
ZROK_DOMINIO=
NGROK_DOMAIN=
NGROK_AUTHTOKEN=
# Quem abre pelo QR code vê "Entrar como visitante" e entra na conta de
# visitante (papel convidado; qual conta é configuração do banco), sem senha —
# só pelo link público e só enquanto essa conta estiver ativa:
#   npm run usuario -- criar visitante --papel convidado --sem-senha
# Opcional: endereço público fixo, por cima do detectado (ex.: um túnel
# Cloudflare aberto à parte): https://painel.exemplo.com.br
PLATEIA_URL=
