{
  "name": "omni-root-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Dashboard de leitura (PostgreSQL central) — inspeção de toras Omni-Root",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client,tunel -c blue,green,magenta \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:tunel\"",
    "dev:server": "node scripts/servidor.mjs",
    "dev:client": "vite",
    "dev:tunel": "node scripts/tunel.mjs",
    "dev:celular": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"vite --host\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "usuario": "node --import tsx scripts/usuario.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "compression": "^1.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jpeg-js": "^0.4.4",
    "leaflet": "^1.9.4",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
